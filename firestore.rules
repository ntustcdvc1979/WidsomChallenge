rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 玩家：rooms/{room}/players/{uid} = { name, joinedAt }
    match /rooms/{room}/players/{uid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'joinedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12
        && request.resource.data.joinedAt == request.time;
      allow update, delete: if false;
    }

    // 答對紀錄：rooms/{room}/solves/{uid}_{題目id} = { uid, puzzle, name, at }
    // 每人每題只能寫一次、只能寫自己的；新增題目不用改規則
    match /rooms/{room}/solves/{solveId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'puzzle', 'name', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.puzzle is string
        && request.resource.data.puzzle.matches('^[a-z0-9_-]{1,30}$')
        && solveId == request.auth.uid + '_' + request.resource.data.puzzle
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 12
        && request.resource.data.at == request.time
        && exists(/databases/$(database)/documents/rooms/$(room)/players/$(request.auth.uid));
      allow update, delete: if false;
    }
  }
}
